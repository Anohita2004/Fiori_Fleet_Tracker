<mvc:View
    controllerName="fleetTracker.controller.LiveLocation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page showHeader="false" enableScrolling="true" backgroundDesign="Transparent">
        <content>
            <VBox class="opsPage" width="100%">

                <!-- Header -->
                <HBox class="opsHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <VBox>
                        <Title text="Live Location" level="H1" class="opsTitle"/>
                        <Text text="Real-time interactive map view of your active fleet" class="opsSubtitle"/>
                    </VBox>

                    <HBox alignItems="Center" class="allocStats">
                        <VBox class="allocStat">
                            <Text text="Vehicles on map" class="opsTileLabel"/>
                            <Title text="{= ${fleet>/vehicles}.length }" level="H3"/>
                        </VBox>
                        <Button text="Refresh map" icon="sap-icon://refresh" press=".onRefreshMap" type="Emphasized" class="fleetBtn liveRefresh"/>
                    </HBox>
                </HBox>

                <!-- Map card -->
                <VBox class="opsPanel liveMapCard">

                    <!-- Floating status chip -->
                    <HBox alignItems="Center" class="liveChip">
                        <core:HTML content="&lt;span class=&quot;liveDot&quot;&gt;&lt;/span&gt;"/>
                        <Text text="Live"/>
                    </HBox>

                    <!-- The map container is rendered here. Keep the id: the controller uses it. -->
                    <core:HTML content="&lt;div id=&quot;fleetMapContainer&quot; class=&quot;liveMap&quot;&gt;&lt;/div&gt;"/>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>