<mvc:View
    controllerName="fleetTracker.controller.LiveLocation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page showHeader="false" enableScrolling="true" backgroundDesign="Transparent">
        <content>
            <VBox class="fleetPage" width="100%" height="100%" style="min-height: 100vh;">
                
                <HBox class="sapUiMediumMarginBottom" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <VBox>
                        <Title text="Live Location" level="H1" class="fleetTitle" style="font-size: 2rem;"/>
                        <Text text="Real-time interactive map view of your active fleet" class="fleetSubtitle"/>
                    </VBox>
                    <Button text="Refresh Map" icon="sap-icon://refresh" press=".onRefreshMap" type="Emphasized" style="background:#7956cf; border-color:#7956cf; color:white;"/>
                </HBox>

                <VBox class="fleetFormCard" fitContainer="true" height="100%" style="padding:0;">
                    <!-- The map container is rendered here -->
                    <core:HTML content='&lt;div id=&quot;fleetMapContainer&quot; style=&quot;width:100%; height:600px; border-radius: 1rem; z-index: 1;&quot;&gt;&lt;/div&gt;' />
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
