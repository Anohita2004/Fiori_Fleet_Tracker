<mvc:View
    controllerName="fleetTracker.controller.DriverCreation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" enableScrolling="true" backgroundDesign="Transparent">
        <content>
            <VBox class="opsPage" width="100%">

                <!-- Header -->
                <HBox class="opsHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <VBox>
                        <Title text="Driver Creation" level="H1" class="opsTitle"/>
                        <Text text="Add new driver details to the fleet" class="opsSubtitle"/>
                    </VBox>
                    <Button text="Back to list" icon="sap-icon://nav-back" type="Transparent" class="fleetBtn drvGhostBtn"/>
                </HBox>

                <HBox class="drvMain" wrap="Wrap" alignItems="Start">

                    <!-- Left column: form -->
                    <VBox class="opsPanel drvFormCard">

                        <HBox alignItems="Center" class="drvCardHead">
                            <core:Icon src="sap-icon://employee" size="1.4rem" class="drvIconChip"/>
                            <VBox>
                                <Title text="Driver information" level="H3"/>
                                <Text text="Enter the driver's personal and professional details. Fields marked * are required." class="opsSubtitle"/>
                            </VBox>
                        </HBox>

                        <!-- Personal details -->
                        <HBox alignItems="Center" class="drvSectionHead">
                            <core:Icon src="sap-icon://person-placeholder" class="drvSectionIcon"/>
                            <Title text="Personal details" level="H5"/>
                        </HBox>
                        <HBox wrap="Wrap" class="drvFields">
                            <VBox class="drvField"><Label text="Full name" required="true" labelFor="fullName"/><Input id="fullName" placeholder="Enter full name" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Date of birth" required="true" labelFor="dob"/><DatePicker id="dob" placeholder="dd-mm-yyyy" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Gender" required="true" labelFor="gender"/><ComboBox id="gender" placeholder="Select gender" width="100%" class="allocInput"><core:Item key="M" text="Male"/><core:Item key="F" text="Female"/></ComboBox></VBox>
                            <VBox class="drvField"><Label text="Contact number" required="true" labelFor="contact"/><Input id="contact" type="Tel" placeholder="Enter 10 digit number" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Email ID" labelFor="email"/><Input id="email" type="Email" placeholder="Enter email address" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Address" required="true" labelFor="address"/><Input id="address" placeholder="Enter complete address" width="100%" class="allocInput"/></VBox>
                        </HBox>

                        <!-- Driving details -->
                        <HBox alignItems="Center" class="drvSectionHead">
                            <core:Icon src="sap-icon://steering-wheel" class="drvSectionIcon"/>
                            <Title text="Driving details" level="H5"/>
                        </HBox>
                        <HBox wrap="Wrap" class="drvFields">
                            <VBox class="drvField"><Label text="License number" required="true" labelFor="licenseNo"/><Input id="licenseNo" placeholder="Enter license number" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="License expiry date" required="true" labelFor="licenseExpiry"/><DatePicker id="licenseExpiry" placeholder="dd-mm-yyyy" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="License type" required="true" labelFor="licenseType"/><ComboBox id="licenseType" placeholder="Select license type" width="100%" class="allocInput"><core:Item key="H" text="Heavy Commercial"/><core:Item key="L" text="Light Motor Vehicle"/></ComboBox></VBox>
                            <VBox class="drvField"><Label text="Years of experience" required="true" labelFor="experience"/><Input id="experience" type="Number" placeholder="Enter years of experience" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Driving experience (vehicle type)" labelFor="vehicleType"/><ComboBox id="vehicleType" placeholder="Select vehicle type" width="100%" class="allocInput"><core:Item key="T" text="Truck"/><core:Item key="V" text="Van"/></ComboBox></VBox>
                        </HBox>

                        <!-- Employment details -->
                        <HBox alignItems="Center" class="drvSectionHead">
                            <core:Icon src="sap-icon://suitcase" class="drvSectionIcon"/>
                            <Title text="Employment details" level="H5"/>
                        </HBox>
                        <HBox wrap="Wrap" class="drvFields">
                            <VBox class="drvField"><Label text="Joining date" required="true" labelFor="joiningDate"/><DatePicker id="joiningDate" placeholder="dd-mm-yyyy" width="100%" class="allocInput"/></VBox>
                            <VBox class="drvField"><Label text="Assigned vehicle (optional)" labelFor="assignedVehicle"/><ComboBox id="assignedVehicle" placeholder="Select vehicle" width="100%" class="allocInput"><core:Item key="T1" text="TRK-001"/></ComboBox></VBox>
                            <VBox class="drvField"><Label text="Status" required="true" labelFor="driverStatus"/><ComboBox id="driverStatus" selectedKey="A" width="100%" class="allocInput"><core:Item key="A" text="Active"/><core:Item key="I" text="Inactive"/></ComboBox></VBox>
                            <VBox class="drvField"><Label text="Emergency contact number" required="true" labelFor="emergencyContact"/><Input id="emergencyContact" type="Tel" placeholder="Enter emergency contact" width="100%" class="allocInput"/></VBox>
                        </HBox>

                        <!-- Actions -->
                        <HBox justifyContent="End" wrap="Wrap" class="drvActions">
                            <Button text="Cancel" icon="sap-icon://sys-cancel" type="Transparent" class="fleetBtn drvGhostBtn"/>
                            <Button text="Reset" icon="sap-icon://refresh" type="Transparent" class="fleetBtn drvGhostBtn"/>
                            <Button text="Create driver" icon="sap-icon://add-employee" type="Emphasized" class="fleetBtn"/>
                        </HBox>
                    </VBox>

                    <!-- Right column -->
                    <VBox class="drvSide">

                        <!-- Photo -->
                        <VBox class="opsPanel">
                            <HBox alignItems="Center" class="drvCardHead">
                                <core:Icon src="sap-icon://picture" size="1.2rem" class="drvIconChip"/>
                                <VBox>
                                    <Title text="Driver photo" level="H5"/>
                                    <Text text="Upload a clear passport size photo" class="opsSubtitle drvTiny"/>
                                </VBox>
                            </HBox>

                            <VBox alignItems="Center" justifyContent="Center" class="drvDropZone">
                                <core:Icon src="sap-icon://person-placeholder" size="2.5rem" class="drvDropIcon"/>
                                <Title text="Drag and drop an image here" level="H6"/>
                                <Text text="or click to browse" class="opsSubtitle"/>
                                <Text text="JPG, JPEG, PNG (max 2 MB)" class="opsSubtitle drvTiny"/>
                            </VBox>

                            <MessageStrip text="Use a clear, recent photo so the driver can be identified." type="Information" showIcon="true" class="sapUiSmallMarginTop"/>
                        </VBox>

                        <!-- Documents -->
                        <VBox class="opsPanel">
                            <HBox alignItems="Center" class="drvCardHead">
                                <core:Icon src="sap-icon://document" size="1.2rem" class="drvIconChip"/>
                                <VBox>
                                    <Title text="Documents" level="H5"/>
                                    <Text text="Upload the driver's documents (optional)" class="opsSubtitle drvTiny"/>
                                </VBox>
                            </HBox>

                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="drvDocRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://attachment" class="drvSectionIcon"/>
                                    <VBox>
                                        <Title text="Driving license" level="H6"/>
                                        <Text text="PDF, JPG, PNG (max 5 MB)" class="opsSubtitle drvTiny"/>
                                    </VBox>
                                </HBox>
                                <Button text="Upload" icon="sap-icon://upload" type="Transparent" class="fleetBtn drvGhostBtn"/>
                            </HBox>

                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="drvDocRow">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://attachment" class="drvSectionIcon"/>
                                    <VBox>
                                        <Title text="ID proof" level="H6"/>
                                        <Text text="PDF, JPG, PNG (max 5 MB)" class="opsSubtitle drvTiny"/>
                                    </VBox>
                                </HBox>
                                <Button text="Upload" icon="sap-icon://upload" type="Transparent" class="fleetBtn drvGhostBtn"/>
                            </HBox>
                        </VBox>

                        <!-- Recent drivers -->
                        <VBox class="opsPanel drvRecent">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="drvCardHead">
                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://group" size="1.2rem" class="drvIconChip"/>
                                    <Title text="Recent drivers" level="H5"/>
                                </HBox>
                                <Link text="View all"/>
                            </HBox>

                            <Table class="sapUiNoMargin drvTable" showSeparators="Inner">
                                <columns>
                                    <Column><Text text="Name" class="opsSubtitle drvTiny"/></Column>
                                    <Column demandPopin="true" minScreenWidth="Tablet"><Text text="License no." class="opsSubtitle drvTiny"/></Column>
                                    <Column hAlign="Center"><Text text="Status" class="opsSubtitle drvTiny"/></Column>
                                    <Column hAlign="End" width="3rem"/>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Title text="John Doe" level="H6"/>
                                            <Text text="MH12AB1234" class="drvTiny"/>
                                            <ObjectStatus text="Active" state="Success" inverted="true"/>
                                            <core:Icon src="sap-icon://show" color="#7050d0" tooltip="View driver"/>
                                        </cells>
                                    </ColumnListItem>
                                    <ColumnListItem>
                                        <cells>
                                            <Title text="Jane Smith" level="H6"/>
                                            <Text text="KA05CD5678" class="drvTiny"/>
                                            <ObjectStatus text="Active" state="Success" inverted="true"/>
                                            <core:Icon src="sap-icon://show" color="#7050d0" tooltip="View driver"/>
                                        </cells>
                                    </ColumnListItem>
                                    <ColumnListItem>
                                        <cells>
                                            <Title text="Mike Johnson" level="H6"/>
                                            <Text text="DL01EF9012" class="drvTiny"/>
                                            <ObjectStatus text="Inactive" state="Error" inverted="true"/>
                                            <core:Icon src="sap-icon://show" color="#7050d0" tooltip="View driver"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>