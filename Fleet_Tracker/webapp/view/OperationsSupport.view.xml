<mvc:View
    controllerName="fleetTracker.controller.OperationsSupport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" enableScrolling="true" backgroundDesign="Transparent">
        <content>
            <VBox class="opsPage" width="100%">

                <!-- Header: title on the left, search and vehicle picker on the right -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="opsHeader">
                    <VBox>
                        <Title text="Track Operations Support" level="H1" class="opsTitle"/>
                        <Text text="Track every load from warehouse to last-mile delivery" class="opsSubtitle"/>
                    </VBox>

                    <HBox alignItems="Center" class="opsToolbar">
                        <core:Icon src="sap-icon://search" class="opsToolbarIcon"/>
                        <Input placeholder="Search shipments" width="12rem" class="opsSearch"/>
                        <ComboBox selectedKey="V" width="14rem" class="opsVehicleSelect" showSecondaryValues="true">
                            <core:ListItem key="V" text="Volvo FH 500" additionalText="LKS29H0"/>
                            <core:ListItem key="H" text="Hino 300 Series" additionalText="VG3TKL0"/>
                            <core:ListItem key="D" text="DAF LF 230" additionalText="DS2R8AM"/>
                        </ComboBox>
                    </HBox>
                </HBox>

                <!-- Hero: truck photo with the cargo overlay on the trailer -->
                <VBox class="opsTruckContainer">
                    <Image
                        src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&amp;fit=crop&amp;w=1200&amp;q=80"
                        alt="Truck carrying relief cargo"
                        width="100%"
                        height="400px"
                        class="opsHeroImage"/>
                    <HBox wrap="Wrap" class="opsCargoOverlay">
                        <VBox class="opsCargoTile"><Text text="Food &amp; water" class="opsTileLabel"/><Title text="4,800 kg" level="H4"/></VBox>
                        <VBox class="opsCargoTile"><Text text="Medical supplies" class="opsTileLabel"/><Title text="2,200 kg" level="H4"/></VBox>
                        <VBox class="opsCargoTile"><Text text="Shelter kits" class="opsTileLabel"/><Title text="5,400 kg" level="H4"/></VBox>
                        <VBox class="opsCargoTile"><Text text="Clothing &amp; blankets" class="opsTileLabel"/><Title text="1,500 kg" level="H4"/></VBox>
                        <VBox class="opsCargoTile"><Text text="Mixed relief" class="opsTileLabel"/><Title text="6,100 kg" level="H4"/></VBox>
                        <VBox class="opsCargoTile"><Text text="Sanitation" class="opsTileLabel"/><Title text="1,800 kg" level="H4"/></VBox>
                    </HBox>
                </VBox>

                <!-- Filters -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="opsFilterRow">
                    <SegmentedButton selectedKey="primary" class="opsSegmented">
                        <items>
                            <SegmentedButtonItem text="Primary" key="primary"/>
                            <SegmentedButtonItem text="Urgent" key="urgent"/>
                            <SegmentedButtonItem text="Standby" key="standby"/>
                        </items>
                    </SegmentedButton>

                    <SegmentedButton selectedKey="A" class="opsSegmented opsSegmentedAccent">
                        <items>
                            <SegmentedButtonItem text="Zone A - 65%" key="A"/>
                            <SegmentedButtonItem text="Zone B" key="B"/>
                            <SegmentedButtonItem text="Zone C" key="C"/>
                        </items>
                    </SegmentedButton>

                    <HBox alignItems="Center">
                        <SegmentedButton selectedKey="side" class="opsSegmented sapUiSmallMarginEnd">
                            <items>
                                <SegmentedButtonItem text="Side" key="side"/>
                                <SegmentedButtonItem text="Top" key="top"/>
                            </items>
                        </SegmentedButton>
                        <SegmentedButton class="opsSegmented">
                            <items>
                                <SegmentedButtonItem text="-" key="minus"/>
                                <SegmentedButtonItem text="+" key="plus"/>
                            </items>
                        </SegmentedButton>
                    </HBox>
                </HBox>

                <!-- Cargo detail cards -->
                <ScrollContainer horizontal="true" vertical="false" width="100%" class="opsCargoScroll">
                    <HBox wrap="NoWrap">
                        <VBox class="opsCargoCard">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop"><Title text="Food &amp; water" level="H5"/><Text text="primary" class="opsPillPrimary"/></HBox>
                            <Title text="4,800 kg" level="H3" class="opsCardValue"/>
                            <Text text="240 x 120 x 110 cm" class="opsSubtitle"/>
                        </VBox>
                        <VBox class="opsCargoCard">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop"><Title text="Medical supplies" level="H5"/><Text text="primary" class="opsPillPrimary"/></HBox>
                            <Title text="2,200 kg" level="H3" class="opsCardValue"/>
                            <Text text="180 x 100 x 90 cm" class="opsSubtitle"/>
                        </VBox>
                        <VBox class="opsCargoCard">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop"><Title text="Clothing &amp; blankets" level="H5" wrapping="true"/><Text text="primary" class="opsPillPrimary"/></HBox>
                            <Title text="1,500 kg" level="H3" class="opsCardValue"/>
                            <Text text="200 x 110 x 95 cm" class="opsSubtitle"/>
                        </VBox>
                        <VBox class="opsCargoCard">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop"><Title text="Mixed relief" level="H5"/><Text text="primary" class="opsPillPrimary"/></HBox>
                            <Title text="6,100 kg" level="H3" class="opsCardValue"/>
                            <Text text="300 x 120 x 130 cm" class="opsSubtitle"/>
                        </VBox>
                        <VBox class="opsCargoCard">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop"><Title text="Shelter kits" level="H5"/><Text text="primary" class="opsPillPrimary"/></HBox>
                            <Title text="5,400 kg" level="H3" class="opsCardValue"/>
                            <Text text="380 x 120 x 140 cm" class="opsSubtitle"/>
                        </VBox>
                    </HBox>
                </ScrollContainer>

                <!-- Bottom row: map, details, trip stats, camera -->
                <HBox wrap="Wrap" alignItems="Stretch" class="opsBottomRow">

                    <!-- Route map -->
                    <VBox class="opsPanel opsMapCard">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="opsCardTop">
                            <Title text="Route map tracking" level="H5"/>
                            <Text text="In transit" class="opsPillDark"/>
                        </HBox>
                        <Text text="Albania → Norway" class="opsSubtitle opsCardGap"/>
                        <Image
                            src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&amp;fit=crop&amp;w=400&amp;q=80"
                            alt="Route map from Albania to Norway"
                            width="100%"
                            height="150px"
                            class="opsMapImage"/>
                    </VBox>

                    <!-- Operation details -->
                    <VBox class="opsPanel opsDetailsCard">
                        <Title text="Operation details" level="H5" class="opsCardGap"/>
                        <Text text="Logistic ID" class="opsSubtitle"/>
                        <Title text="VDC-222987" level="H6" class="opsDetailValue"/>
                        <Text text="Distance" class="opsSubtitle"/>
                        <Title text="2,680 mi" level="H6" class="opsDetailValue"/>
                        <Text text="Delivery estimate" class="opsSubtitle"/>
                        <Title text="6h 40min" level="H6" class="opsDetailValue"/>
                        <Text text="Item type" class="opsSubtitle"/>
                        <Title text="Humanitarian aid" level="H6"/>
                    </VBox>

                    <!-- Fuel and speed -->
                    <VBox class="opsStatsCol">
                        <VBox class="opsPanel opsStatCard">
                            <Title text="Fuel estimation" level="H6" class="opsCardGap"/>
                            <HBox width="100%" class="opsBar opsCardGap">
                                <VBox class="opsBarSeg opsBarOn opsBarViolet" width="70%"/>
                                <VBox class="opsBarSeg opsBarOff" width="30%"/>
                            </HBox>
                            <HBox justifyContent="SpaceBetween"><Title text="7.8 MPG" level="H6"/><Text text="Economic" class="opsSubtitle"/></HBox>
                        </VBox>

                        <VBox class="opsPanel opsStatCard">
                            <Title text="Average speed" level="H6" class="opsCardGap"/>
                            <HBox width="100%" class="opsBar opsCardGap">
                                <VBox class="opsBarSeg opsBarOn opsBarGreen" width="30%"/>
                                <VBox class="opsBarSeg opsBarOn opsBarGreen" width="30%"/>
                                <VBox class="opsBarSeg opsBarOff" width="40%"/>
                            </HBox>
                            <HBox justifyContent="SpaceBetween"><Title text="60 - 80 km/h" level="H6"/><Text text="Standard" class="opsSubtitle"/></HBox>
                        </VBox>
                    </VBox>

                    <!-- Camera feed -->
                    <VBox class="opsCameraCard" justifyContent="SpaceBetween">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <HBox alignItems="Center">
                                <Text text="Camera" class="opsCameraText opsCameraTitle"/>
                                <Text text="Live" class="opsPillLive"/>
                            </HBox>
                            <core:Icon src="sap-icon://full-screen" color="#ffffff" tooltip="Full screen"/>
                        </HBox>
                        <VBox height="80px"/>
                        <VBox>
                            <Title text="Container space" level="H5" class="opsCameraText"/>
                            <HBox justifyContent="SpaceBetween" class="opsCameraMeta">
                                <Text text="23/04/2026 - 10:32:40" class="opsCameraText opsCameraSmall"/>
                                <Text text="4K (3840 x 2160)" class="opsCameraText opsCameraSmall"/>
                            </HBox>
                        </VBox>
                    </VBox>

                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>